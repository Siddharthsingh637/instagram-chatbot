# Application Environment: development | production | test
APP_ENV=development

# Database URL (PostgreSQL for production/Supabase, SQLite used automatically in tests)
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/instagram_bot

# AI Provider Configuration
# Supported: groq | openrouter | gemini
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Meta / Instagram Messaging API
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_meta_webhook_verify_token_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
GRAPH_API_VERSION=v21.0

# Admin API Security
ADMIN_API_KEY=your_admin_secret_key_here

# Message Retention & Memory Policy
MESSAGE_RETENTION_HOURS=6
REPLY_COOLDOWN_SECONDS=10
MAX_CONTEXT_MESSAGES=15
HANDOFF_KEYWORDS=human,agent,real person
